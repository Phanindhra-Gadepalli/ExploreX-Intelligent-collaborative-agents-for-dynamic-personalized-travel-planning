# ============================================================================
# ExploreX — environment configuration template
# ----------------------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in real values.
#   cp .env.example .env        (Linux / macOS / Git-Bash)
#   copy .env.example .env      (Windows cmd)
# The app loads it automatically via python-dotenv on startup.
# NEVER commit a populated `.env` to version control.
# ============================================================================

# ── LLM / Gemini (REQUIRED) ──────────────────────────────────────────────────
# langchain-google-genai reads GOOGLE_API_KEY; the legacy utils.py path reads
# GEMINI_API_KEY. Set BOTH to the same key to cover every code path.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ── Flask / sessions ─────────────────────────────────────────────────────────
# A long random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# ── Maps / POI providers ─────────────────────────────────────────────────────
# Geoapify Places API key — powers attraction/accommodation/restaurant discovery.
# Get a free key at https://www.geoapify.com/get-api-key/
GEOAPIFY_API_KEY=
# Pexels image API key — optional; used to attach photos to POIs.
PEXELS_API_KEY=
# RapidAPI key — optional; powers live car-rental lookups (degrades gracefully).
RAPIDAPI_KEY=

# ── Overpass (OpenStreetMap) tuning — optional ────────────────────────────────
# Comma-separated mirror list; defaults to built-in public mirrors if unset.
# OVERPASS_ENDPOINTS=https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter
# Per-request read timeout in seconds (default 25).
# OVERPASS_TIMEOUT=25

# ── Authentication (optional — only needed for Google/Apple sign-in) ──────────
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ── Email delivery (optional — /api/email + auto-send degrade if unset) ───────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ── Evaluation harness (optional — only used by workflows/evaluation.py) ──────
OPENAI_API_KEY=

# ── Deployment (optional) ─────────────────────────────────────────────────────
# For local dev you can ignore all of these; defaults run on 127.0.0.1:8000.
# Set PRODUCTION=1 (or FLASK_ENV=production) to serve via Waitress with the
# debugger off and secure cookies on.
# PRODUCTION=1
# FLASK_DEBUG=0
# FLASK_ENV=production
# HOST=0.0.0.0
# PORT=8000
# WEB_CONCURRENCY=8
# COOKIE_SECURE=1
